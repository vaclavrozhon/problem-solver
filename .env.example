AUTH_MODE=local
LOCAL_AUTH_USERNAME=admin
LOCAL_AUTH_PASSWORD=admin
LOCAL_AUTH_USER_ID=00000000-0000-4000-8000-000000000001
LOCAL_AUTH_NAME=Local Admin
LOCAL_AUTH_EMAIL=admin@local

SUPABASE_URL=
# Not using `public` key as SupabaseSDK is only used on the server
# on backend and sometimes the `admin` permissions are required
# sb_secrete_...
SUPABASE_SECRET_KEY=

DATABASE_PASSWORD=
# Password in the connection string needs to be replaced with 
# [DATABASE_PASSWORD]
# to be properly handled during parsing
# postgresql://...:[DATABASE_PASSWORD]@...
DATABASE_URL=

# redis://...:...@...
REDIS_URL=
# Filesystem mirror of problem outputs
OUTPUT_MIRROR_ENABLED=1
# Relative paths are resolved from repository root.
OUTPUT_MIRROR_ROOT=outputs
# Startup behavior for persisted BullMQ jobs after backend restart:
# - fail_and_purge: mark in-flight problems as failed and purge unfinished queued jobs
# - none: keep BullMQ default recovery behavior (may resume old jobs)
JOB_STARTUP_RECOVERY_MODE=fail_and_purge
# BullMQ worker tuning for long-running LLM jobs
BULLMQ_CONCURRENCY=10
BULLMQ_LOCK_DURATION_MS=1800000
BULLMQ_STALLED_INTERVAL_MS=30000

FRONTEND_PORT=5175
# If blank, defaults to `3942`
BACKEND_PORT=5174
# Required by Vite to know where the API is located at in `dev` env
VITE_BACKEND_PORT=$BACKEND_PORT
VITE_AUTH_MODE=$AUTH_MODE

OPENROUTER_API_KEY=
#  Required for Admin Invite Management
OPENROUTER_PROVISION_KEY=
METACENTRUM_BASE_URL=https://llm.ai.e-infra.cz/v1
# Encrypts user OpenRouter API keys
# Generate via e.g. `openssl rand -base64 32`
ENCRYPTION_MASTER_KEY_V1=

# Path to Codex binary (optional)
CODEX_BIN=codex
# Timeout for local Codex calls in milliseconds
CODEX_TIMEOUT_MS=1800000
# Enable debug logs/artifacts for local Codex CLI (optional)
CODEX_DEBUG=0

# Path to OpenCode binary (optional)
OPENCODE_BIN=opencode
# Timeout for local OpenCode calls in milliseconds
OPENCODE_TIMEOUT_MS=1800000
# Enable debug logs/artifacts for local OpenCode CLI (optional)
OPENCODE_DEBUG=0

# Path to Claude Code binary (optional)
CLAUDE_BIN=claude
# Timeout for local Claude calls in milliseconds
CLAUDE_TIMEOUT_MS=1800000
# Enable debug logs/artifacts for local Claude CLI (optional)
CLAUDE_DEBUG=0


# RAILWAY ONLY #

# Must be set up in Railway to mirror `RAILWAY_PUBLIC_DOMAIN`
# The frontend needs to know the domain for backend API requests
VITE_RAILWAY_PUBLIC_DOMAIN=
